{
  // Déploiement Cloudflare du site : fichiers statiques + API (formulaires, espaces client et admin, assistant IA)
  "name": "renaissance-itech",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "renaissance-itech-db",
      "database_id": "bb5883ef-436c-44fd-8396-50e01920167f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://www.renaissance-itech.com",
    "NOTIFY_EMAIL": "contact@renaissance-itech.com",
    "SENDER_EMAIL": "contact@renaissance-itech.com",
    "BREVO_LIST_ID": "2",
    "ADMIN_EMAILS": "contact@renaissance-itech.com,renaissanceitech@gmail.com",
    // Anti-robot Cloudflare Turnstile : clé publique (la clé secrète TURNSTILE_SECRET est un secret Cloudflare)
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFDtPw94300W7Dv4"
    // BREVO_API_KEY : secret à ajouter dans Cloudflare. BREVO_DOI_TEMPLATE_ID (facultatif) : ID du modèle de double opt-in (voir NEWSLETTER.md)
  },
  "ai": { "binding": "AI" },
  // Nettoyage des données chaque nuit à 3 h 17 (UTC) : durées de conservation RGPD
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true },
  // Prévisualisations des PR (npx wrangler preview) : base de test séparée, jamais les données réelles.
  // Migrations de la base de test : npx wrangler d1 migrations apply renaissance-itech-preview --remote --config wrangler.preview-migrations.jsonc
  "previews": {
    "vars": {
      "SITE_URL": "https://www.renaissance-itech.com",
      "NOTIFY_EMAIL": "contact@renaissance-itech.com",
      "SENDER_EMAIL": "contact@renaissance-itech.com",
      "BREVO_LIST_ID": "2",
      "ADMIN_EMAILS": "contact@renaissance-itech.com,renaissanceitech@gmail.com"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "renaissance-itech-preview",
        "database_id": "e26539a5-03ff-4f6c-92a0-bd61fa6d7aec"
      }
    ],
    "ai": { "binding": "AI" }
  }
}
